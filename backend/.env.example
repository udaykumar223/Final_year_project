# SmartCrop AI — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=smartcrop_ai

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model
MODEL_CHECKPOINT_PATH=../ai_model/checkpoints/best_model.pth
CLASS_NAMES_PATH=../ai_model/class_names.json
